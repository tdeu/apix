{
  "name": "apix-hedera",
  "version": "2.1.2",
  "description": "CLI that adds working Hedera integrations (HTS, HCS, smart contracts, wallet) to Next.js apps, with optional AI help",
  "main": "dist/cli/index.js",
  "bin": {
    "apix": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/__tests__/**",
    "!dist/docs-check/**",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "build:check": "tsc --noEmit",
    "build:strict": "tsc --noEmit --strict",
    "dev": "nodemon --exec ts-node src/cli/index.ts",
    "test": "jest",
    "test:types": "npm run build:check",
    "test:claude": "npx ts-node scripts/test-with-claude.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "snapshot:templates": "ts-node --transpile-only scripts/snapshot-templates.ts",
    "e2e:generate": "ts-node --transpile-only scripts/e2e-generate.ts",
    "check:docs": "ts-node --transpile-only scripts/check-docs.ts",
    "proof:testnet": "ts-node --transpile-only scripts/testnet-proof.ts",
    "audit:mocks": "./scripts/audit-mocks.sh",
    "audit:prod": "node scripts/audit-prod.mjs",
    "precommit": "npm run build:check && npm run lint && npm test",
    "validate:env": "node -e \"require('dotenv').config(); console.log('Environment check (values not shown):'); ['HEDERA_ACCOUNT_ID', 'HEDERA_PRIVATE_KEY', 'HEDERA_NETWORK', 'ANTHROPIC_API_KEY', 'OPENAI_API_KEY'].forEach(key => console.log(key + ':', process.env[key] ? 'set' : 'missing'));\"",
    "apix": "npx ts-node src/cli/index.ts",
    "apix:help": "npm run apix -- --help",
    "apix:health": "npm run apix -- health --quick",
    "apix:analyze": "npm run apix -- analyze --directory .",
    "apix:add:hts": "npm run apix -- add hts --name TestToken --symbol TEST",
    "apix:add:wallet": "npm run apix -- add wallet",
    "apix:recommend": "npm run apix -- recommend --industry pharmaceutical",
    "apix:validate": "npm run apix -- validate",
    "apix:generate": "npm run apix -- generate smart-contract --industry pharmaceutical",
    "apix:chat": "npm run apix -- chat",
    "apix:status": "npm run apix -- status",
    "apix:init": "npm run apix -- init",
    "apix:create-token": "npm run apix -- create-token --name 'DemoToken' --symbol 'DEMO' --supply 1000000",
    "install:global": "npm run build && npm install -g .",
    "link:local": "npm run build && npm link",
    "unlink": "npm unlink -g apix-hedera",
    "cli:help": "npx ts-node src/cli/index.ts --help",
    "cli:health": "npx ts-node src/cli/index.ts health --quick",
    "cli:analyze": "npx ts-node src/cli/index.ts analyze --directory .",
    "cli:test": "npx ts-node src/cli/index.ts"
  },
  "keywords": [
    "hedera",
    "hashgraph",
    "hts",
    "hcs",
    "smart-contracts",
    "cli",
    "nextjs",
    "code-generation",
    "web3"
  ],
  "author": "Emtée Studio",
  "contributors": [
    "Moustapha Diop",
    "Thomas De Rouck"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdeu/apix.git"
  },
  "bugs": {
    "url": "https://github.com/tdeu/apix/issues"
  },
  "homepage": "https://github.com/tdeu/apix#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@hashgraph/sdk": "2.80.0",
    "blessed": "^0.1.81",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "configstore": "^7.1.0",
    "dotenv": "^16.0.0",
    "fs-extra": "^11.1.1",
    "fuzzysort": "^3.1.0",
    "handlebars": "^4.7.10",
    "inquirer": "^9.2.12",
    "openai": "^4.0.0",
    "ora": "^5.4.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/blessed": "^0.1.25",
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.0",
    "@types/uuid": "^9.0.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "solc": "^0.8.37",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "@grpc/grpc-js": "1.13.6"
  }
}
