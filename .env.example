# APIX CLI configuration. Copy to .env in the directory where you run apix.
# Only variables APIX reads are listed. Never commit the real file.
# (A generated Next.js app reads its own .env.local; see docs/integrations.md.)

# --- Hedera (create-token, validate, add hts --create-token) ---
# Operator account ID; a free testnet account: https://portal.hedera.com/faucet
HEDERA_ACCOUNT_ID=0.0.xxxxx
# Operator private key, DER-encoded (starts with 302). Kept on your machine only.
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
# testnet (default) or mainnet; mainnet asks before spending HBAR
HEDERA_NETWORK=testnet

# --- AI commands (chat, generate, recommend, explain, compare, confidence, debug, compose) ---
# Anthropic is used when set; otherwise OpenAI. One of the two is enough.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
# Optional model overrides (defaults shown)
# APIX_ANTHROPIC_MODEL=claude-sonnet-5
# APIX_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# APIX_OPENAI_MODEL=gpt-4o-mini
# Set to 1 to list the experimental compose command in --help
# APIX_EXPERIMENTAL=1

# --- Optional ---
# Only reported by `apix health`; the generated wallet code doesn't use WalletConnect yet
# WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
# Log level for chat's log-level toggle (error, warn, info, debug)
# LOG_LEVEL=info
