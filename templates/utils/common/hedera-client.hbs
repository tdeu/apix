{{!-- META: {"name": "Hedera Client", "description": "Hedera SDK client configuration", "language": "typescript"} --}}
{{#ifFramework framework "next.js"}}import 'server-only';
{{/ifFramework}}
{{#ifLanguage language "typescript"}}import { Client, PrivateKey, AccountId } from '@hiero-ledger/sdk';

export interface HederaClientConfig {
  network: 'testnet' | 'mainnet';
  accountId: string;
  privateKey: string;
  mirrorNodeUrl?: string;
}

/**
 * Hedera SDK client with an operator account. Server-side only: it holds the
 * operator's private key.
 */
export class HederaClient {
  private readonly client: Client;
  private readonly operatorAccountId: AccountId;
  private readonly operatorPrivateKey: PrivateKey;

  constructor(config: HederaClientConfig) {
{{else}}const { Client, PrivateKey, AccountId } = require('@hiero-ledger/sdk');

/**
 * Hedera SDK client with an operator account. Server-side only: it holds the
 * operator's private key.
 */
class HederaClient {
  constructor(config) {
{{/ifLanguage}}
    this.client = config.network === 'mainnet' ? Client.forMainnet() : Client.forTestnet();

    // DER-encoded keys say which algorithm they are; raw hex keys are ECDSA
    this.operatorAccountId = AccountId.fromString(config.accountId);
    this.operatorPrivateKey = config.privateKey.startsWith('302')
      ? PrivateKey.fromStringDer(config.privateKey)
      : PrivateKey.fromStringECDSA(config.privateKey);
    this.client.setOperator(this.operatorAccountId, this.operatorPrivateKey);

    if (config.mirrorNodeUrl) {
      this.client.setMirrorNetwork(toMirrorNetworkAddress(config.mirrorNodeUrl));
    }
  }

  getClient(){{#ifLanguage language "typescript"}}: Client{{/ifLanguage}} {
    return this.client;
  }

  getOperatorAccountId(){{#ifLanguage language "typescript"}}: AccountId{{/ifLanguage}} {
    return this.operatorAccountId;
  }

  getOperatorPrivateKey(){{#ifLanguage language "typescript"}}: PrivateKey{{/ifLanguage}} {
    return this.operatorPrivateKey;
  }

  async close(){{#ifLanguage language "typescript"}}: Promise<void>{{/ifLanguage}} {
    this.client.close();
  }
}

/**
 * The SDK wants the mirror node's gRPC address ("host:443"), but .env files
 * usually hold its REST URL ("https://testnet.mirrornode.hedera.com").
 */
function toMirrorNetworkAddress(value{{#ifLanguage language "typescript"}}: string{{/ifLanguage}}){{#ifLanguage language "typescript"}}: string{{/ifLanguage}} {
  if (!/^[a-z]+:\/\//i.test(value)) {
    return value;
  }
  const url = new URL(value);
  return `${url.hostname}:${url.port || '443'}`;
}

let defaultClient{{#ifLanguage language "typescript"}}: HederaClient | null{{/ifLanguage}} = null;

/**
 * The client for HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY, created on first use
 * (never at import time, so `next build` works without credentials) and then
 * reused. Throws if the credentials are missing.
 */
{{#ifLanguage language "typescript"}}export {{/ifLanguage}}function createDefaultClient(){{#ifLanguage language "typescript"}}: HederaClient{{/ifLanguage}} {
  if (!defaultClient) {
    const accountId = process.env.HEDERA_ACCOUNT_ID;
    const privateKey = process.env.HEDERA_PRIVATE_KEY;
    if (!accountId || !privateKey) {
      throw new Error(
        'HEDERA_ACCOUNT_ID and HEDERA_PRIVATE_KEY must be set on the server (e.g. in .env.local). ' +
        'Get a free testnet account at https://portal.hedera.com/faucet'
      );
    }
    defaultClient = new HederaClient({
      network: process.env.HEDERA_NETWORK === 'mainnet' ? 'mainnet' : 'testnet',
      accountId,
      privateKey,
      mirrorNodeUrl: process.env.HEDERA_MIRROR_NODE_URL,
    });
  }
  return defaultClient;
}

{{#ifLanguage language "javascript"}}
module.exports = {
  HederaClient,
  createDefaultClient
};
{{else}}
export default HederaClient;
{{/ifLanguage}}
