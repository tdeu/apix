{{!-- META: {"name": "useTokens Hook", "description": "React hook for token operations", "language": "typescript"} --}}
'use client';

{{#ifLanguage language "typescript"}}import { useState, useCallback } from 'react';
import {
  CreateTokenParams,
  MintTokenParams,
  TransferTokenParams,
  TokenInfo,
  TokenOperationResult,
  UseTokensReturn
} from '{{importFrom "hedera-types"}}';

/**
 * Calls the generated API routes: /api/tokens/create, /api/tokens/mint,
 * /api/tokens/transfer and /api/tokens/info. The operator key stays on the
 * server; nothing here talks to Hedera directly.
 */
export const useTokens = (): UseTokensReturn => {
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleApiCall = useCallback(async <T,>(
    apiCall: () => Promise<T>,
    errorMessage: string
  ): Promise<T> => {
    setIsLoading(true);
    setError(null);

    try {
      return await apiCall();
    } catch (err) {
      const errorMsg = err instanceof Error ? err.message : errorMessage;
      setError(errorMsg);
      throw new Error(errorMsg);
    } finally {
      setIsLoading(false);
    }
  }, []);

  const post = useCallback(async <T,>(route: string, body: unknown, errorMessage: string): Promise<T> => {
    const response = await fetch(route, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const payload = await response.json();
    if (!response.ok) {
      throw new Error(payload.details || payload.error || errorMessage);
    }
    return payload.data as T;
  }, []);

  const createToken = useCallback((params: CreateTokenParams) =>
    handleApiCall(() => post<TokenOperationResult>('/api/tokens/create', params, 'Failed to create token'), 'Failed to create token'),
  [handleApiCall, post]);

  const mintToken = useCallback((params: MintTokenParams) =>
    handleApiCall(() => post<TokenOperationResult>('/api/tokens/mint', params, 'Failed to mint tokens'), 'Failed to mint tokens'),
  [handleApiCall, post]);

  const transferToken = useCallback((params: TransferTokenParams) =>
    handleApiCall(() => post<TokenOperationResult>('/api/tokens/transfer', params, 'Failed to transfer tokens'), 'Failed to transfer tokens'),
  [handleApiCall, post]);

  const getTokenInfo = useCallback((tokenId: string) =>
    handleApiCall(async () => {
      const response = await fetch(`/api/tokens/info?tokenId=${encodeURIComponent(tokenId)}`);
      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload.details || payload.error || 'Failed to get token info');
      }
      return payload.data as TokenInfo;
    }, 'Failed to get token information'),
  [handleApiCall]);

  const clearError = useCallback(() => {
    setError(null);
  }, []);

  return {
    createToken,
    mintToken,
    transferToken,
    getTokenInfo,
    isLoading,
    error,
    clearError,
  };
};
