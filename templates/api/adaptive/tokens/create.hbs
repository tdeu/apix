      { error: {{#ifEquals quotesStyle 'single'}}'Token creation failed'{{else}}"Token creation failed"{{/ifEquals}} },
      { status: 500 }
    ){{#if usesSemicolons}};{{/if}}
  }
}

module.exports = { POST }{{#if usesSemicolons}};{{/if}}{{/if}}

